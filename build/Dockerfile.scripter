FROM python:3.13-slim-bookworm

COPY src/scripter/requirements.txt /root/requirements.txt

RUN mkdir -p /xml /output /scripts && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        iputils-ping && \
    pip install --no-cache-dir -r /root/requirements.txt && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY src/scripter/scripter.py /root/scripter.py
COPY src/common /root/common
COPY src/scripter/scripts /scripts
COPY --chmod=755 entrypoint.scripter.sh /docker-entrypoint.sh

VOLUME ["/xml", "/output"]
WORKDIR /root
ENTRYPOINT ["/docker-entrypoint.sh"]
